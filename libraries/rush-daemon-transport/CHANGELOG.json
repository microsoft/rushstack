      "comments": {
        "minor": [
          {
            "comment": "Retain daemon ownership while connections stop, refuse a still-live owner, and make endpoint release idempotent across successor startup."
          }
        ],
        "patch": [
          {
            "comment": "Close a newly bound endpoint if publishing daemon ownership fails, avoiding an orphaned listener after failed startup."
          }
