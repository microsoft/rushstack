{
  "$schema": "https://developer.microsoft.com/json-schemas/rush/v5/command-line.schema.json",
  "commands": [
    {
      "commandKind": "phased",
      "name": "ship",
      "summary": "Ships every project, without the build cache or skipping.",
      "enableParallelism": true,
      "incremental": true,
      "disableBuildCache": true,
      "phases": ["_phase:ship"]
    }
  ],
  "phases": [
    {
      "name": "_phase:ship",
      "dependencies": {
        "upstream": ["_phase:ship"]
      }
    }
  ]
}
