{
  "name": "heft-webpack-basic-tutorial",
  "description": "(Copy of sample project) Building this project is a regression test for Heft",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "heft build --clean",
    "start": "heft build-watch",
    "_phase:build": "heft run --only build -- --clean",
    "_phase:test": "heft run --only test -- --clean"
  },
  "dependencies": {
    "react-dom": "catalog:",
    "react": "catalog:",
    "tslib": "catalog:"
  },
  "devDependencies": {
    "@rushstack/heft-jest-plugin": "workspace:*",
    "@rushstack/heft-lint-plugin": "workspace:*",
    "@rushstack/heft-typescript-plugin": "workspace:*",
    "@rushstack/heft-webpack5-plugin": "workspace:*",
    "@rushstack/heft": "workspace:*",
    "@types/jest": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@types/webpack-env": "catalog:",
    "css-loader": "catalog:",
    "eslint": "catalog:",
    "html-webpack-plugin": "catalog:",
    "local-eslint-config": "workspace:*",
    "source-map-loader": "catalog:",
    "style-loader": "catalog:",
    "typescript": "catalog:",
    "webpack": "catalog:"
  }
}
