{
  "name": "heft-serverless-stack-tutorial",
  "description": "(Copy of sample project) Building this project is a regression test for Heft",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test": "heft test --clean",
    "start": "heft build-watch --sst",
    "build": "heft build --clean",
    "deploy": "sst deploy",
    "remove": "sst remove",
    "_phase:build": "heft run --only build -- --clean",
    "_phase:test": "heft run --only test -- --clean"
  },
  "devDependencies": {
    "@aws-sdk/client-sso-oidc": "catalog:",
    "@aws-sdk/client-sts": "catalog:",
    "@rushstack/heft": "workspace:*",
    "@rushstack/heft-jest-plugin": "workspace:*",
    "@rushstack/heft-lint-plugin": "workspace:*",
    "@rushstack/heft-serverless-stack-plugin": "workspace:*",
    "@rushstack/heft-typescript-plugin": "workspace:*",
    "@serverless-stack/aws-lambda-ric": "catalog:",
    "@serverless-stack/cli": "catalog:",
    "@serverless-stack/resources": "catalog:",
    "@types/aws-lambda": "catalog:",
    "@types/jest": "catalog:",
    "@types/node": "catalog:",
    "aws-cdk-lib": "catalog:",
    "constructs": "catalog:",
    "eslint": "catalog:",
    "local-eslint-config": "workspace:*",
    "typescript": "catalog:"
  }
}
